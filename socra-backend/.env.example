# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key  # optional server-side Groq fallback

# App
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Required for background jobs using a personal API key. Share the same
# base64-encoded 32-byte value with Next.js, FastAPI and the worker.
# SOCRA_EXAM_CONCURRENCY=2
SOCRA_JOB_ENCRYPTION_KEY=
# SOCRA_NODE_BIN=node

# Optional model defaults and cost reporting
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_BACKUP_MODEL=
# SOCRA_MODEL_PRICES_JSON={"google:your-model":{"input":0.1,"output":0.4}}
# Optional local OCR. Install Poppler, Tesseract and the selected languages.
# SOCRA_PDFTOPPM_BIN=pdftoppm
# SOCRA_TESSERACT_BIN=tesseract
# SOCRA_OCR_LANGUAGES=eng+fra
