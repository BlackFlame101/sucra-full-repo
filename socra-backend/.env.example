# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key  # optional server-side Groq fallback

# App
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
# Enable Phase 1 Explain features in local development. Both default off without this setting.
SOCRA_ENV=development
# Individual flags override the environment defaults.
# EXPLAIN_TASK_MODES=true
# EXPLAIN_INTENT_PLANS=true
# EXPLAIN_MULTI_EXERCISE_BATCHING=true
# EXPLAIN_DOCUMENT_INVENTORY=true
# EXPLAIN_COVERAGE_CHECK=true
# Phase 0 foundations: explicitly opt in, including in development.
# EXPLAIN_UNIT_PIPELINE=true
# EXPLAIN_DOCUMENT_MODE=true  # experimental document generation, off unless explicitly enabled
# EXPLAIN_GENERATION_FORMAT=json  # json (default) or tagged, for unit generation only
# SOCRA_EXPLAIN_UNIT_MAX_LEARNING_CALLS=12
# SOCRA_EXPLAIN_COVERAGE_MIN_SCREENSHOT_WORDS=10
# SOCRA_EXPLAIN_DOCUMENT_DOMINANCE=0.7
# SOCRA_EXPLAIN_MODEL_LIMITS_JSON=<optional full override of explain_model_limits.json>
# SOCRA_EXPLAIN_EXERCISES_PER_BATCH=3
# SOCRA_EXPLAIN_MAX_BATCH_GROUPS=2
# Maximum exercise targets when batching is disabled.
# SOCRA_EXPLAIN_MAX_EXERCISE_CALLS=4

# Required for background jobs using a personal API key. Share the same
# base64-encoded 32-byte value with Next.js, FastAPI and the worker.
# SOCRA_EXAM_CONCURRENCY=2
SOCRA_JOB_ENCRYPTION_KEY=
# SOCRA_NODE_BIN=node

# Optional model defaults and cost reporting
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_BACKUP_MODEL=
# SOCRA_MODEL_PRICES_JSON={"google:your-model":{"input":0.1,"output":0.4}}
# Optional local OCR. Install Poppler, Tesseract and the selected languages.
# SOCRA_PDFTOPPM_BIN=pdftoppm
# SOCRA_TESSERACT_BIN=tesseract
# SOCRA_OCR_LANGUAGES=eng+fra
